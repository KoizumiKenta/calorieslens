# Copy to .env (same folder) and add ONE of these keys.

# Gemini — free tier available: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if both keys are set (anthropic|gemini; default gemini)
# CALORIELENS_PROVIDER=gemini

# Optional model override (default: gemini-2.5-flash / claude-sonnet-4-6)
# CALORIELENS_MODEL=gemini-2.5-flash
