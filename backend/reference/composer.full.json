{
    "name": "calorielens/backend",
    "type": "project",
    "description": "CalorieLens AI — API, AI orchestration, and admin (Laravel 12, PHP 8.4)",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^6.0",
        "laravel/octane": "^2.6",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "php-open-source-saver/jwt-auth": "^2.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "pgvector/pgvector": "^0.2",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-query-builder": "^6.0",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.7",
        "openai-php/laravel": "^0.11",
        "anthropic-ai/sdk": "^1.0",
        "google-gemini-php/laravel": "^1.0",
        "sentry/sentry-laravel": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "qossmic/deptrac": "^2.0",
        "infection/infection": "^0.29",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "pest --parallel",
        "arch": "deptrac analyse"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
